# .NET build outputs
**/bin/
**/obj/
*.user
.vs/
*.nupkg

# Local env overrides (machine-specific, never shared)
frontend/.env.*.local

# Production secrets — KHÔNG commit lên git
backend/CaseMngmt.Server/appsettings.Production.json

# Frontend dependencies & build
frontend/node_modules/
frontend/build/
frontend/coverage/

# wwwroot — chứa React build (do CI/CD tạo, không commit)
backend/CaseMngmt.Server/wwwroot/*
!backend/CaseMngmt.Server/wwwroot/.gitkeep

# Uploaded files (runtime data, not source)
UploadedFiles/

# Claude memory (personal notes)
.claude/memory/

# OS
.DS_Store
Thumbs.db

# Debug/run logs (local only)
*.log*
